<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.CampusQuest" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Primary Colors -->
        <item name="colorPrimary">@color/primary_cyan</item>
        <item name="colorOnPrimary">@color/on_primary_emerald</item>
        <item name="colorPrimaryContainer">@color/primary_emerald_container</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/secondary_amber</item>
        <item name="colorOnSecondary">@color/on_secondary_amber</item>
        <item name="colorSecondaryContainer">@color/secondary_amber_container</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:colorBackground">@color/bg_dark_base</item>
        <item name="colorSurface">@color/bg_dark_surface</item>
        <item name="colorSurfaceVariant">@color/bg_dark_card</item>

        <!-- Typography & Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/bg_dark_base</item>
        <item name="android:navigationBarColor">@color/bg_dark_base</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.CampusQuest.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg_dark_surface</item>
        <item name="titleTextColor">@color/primary_cyan</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/primary_cyan</item>
    </style>

    <!-- Cyberpunk Button Style -->
    <style name="Widget.CampusQuest.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_cyan</item>
        <item name="android:textColor">@color/on_primary_emerald</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.CampusQuest.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_cyan</item>
        <item name="android:textColor">@color/primary_cyan</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Cyber Card Style -->
    <style name="Widget.CampusQuest.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_dark_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/border_cyber</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
