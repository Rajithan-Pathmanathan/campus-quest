<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.CampusQuest" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorOnPrimary">@color/on_primary_emerald</item>
        <item name="colorPrimaryContainer">@color/primary_emerald_container</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/secondary_amber</item>
        <item name="colorOnSecondary">@color/on_secondary_amber</item>
        <item name="colorSecondaryContainer">@color/secondary_amber_container</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/primary_emerald_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:windowBackground">@drawable/bg_parchment</item>
        <item name="android:navigationBarColor">@color/primary_emerald_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialButtonStyle">@style/Widget.CampusQuest.Button</item>
        <item name="materialCardViewStyle">@style/Widget.CampusQuest.Card</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.CampusQuest</item>
    </style>
<style name="Shape.CampusQuest" parent="ShapeAppearance.Material3.MediumComponent"><item name="cornerSize">20dp</item></style>
<style name="Widget.CampusQuest.Button" parent="Widget.Material3.Button"><item name="cornerRadius">14dp</item><item name="android:minHeight">56dp</item><item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item><item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item></style>
<style name="Widget.CampusQuest.Card" parent="Widget.Material3.CardView.Elevated"><item name="cardBackgroundColor">@color/surface_light</item><item name="strokeColor">@color/divider</item><item name="strokeWidth">1dp</item><item name="cardCornerRadius">20dp</item><item name="cardElevation">2dp</item></style>
</resources>
