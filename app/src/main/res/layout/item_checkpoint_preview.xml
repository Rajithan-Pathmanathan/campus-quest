<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_dark_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_cyber"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Order Circle Badge -->
        <TextView
            android:id="@+id/tv_order_badge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_badge_emerald"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/primary_emerald"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Checkpoint Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_checkpoint_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historic Clock Tower"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_checkpoint_clue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Look skyward where the timekeeper chimes above the quad."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Sensor Chips Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_radius_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_cyan"
                    android:text="📍 25m"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_motion_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_gold"
                    android:text="📳 SWEEP"
                    android:textColor="@color/secondary_amber"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
