<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layoutWidth="match_parent"
    android:layoutHeight="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layoutWidth="match_parent"
        android:layoutHeight="wrap_content"
        android:background="@color/primary_emerald"
        app:title="@string/creator_create_game_title"
        app:titleTextColor="@color/on_primary_emerald"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <androidx.core.widget.NestedScrollView
        android:layoutWidth="match_parent"
        android:layoutHeight="0dp"
        android:layout_weight="1"
        android:padding="@dimen/spacing_m">

        <LinearLayout
            android:layoutWidth="match_parent"
            android:layoutHeight="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_title"
                android:layoutWidth="match_parent"
                android:layoutHeight="wrap_content"
                android:hint="@string/creator_game_title_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_title"
                    android:layoutWidth="match_parent"
                    android:layoutHeight="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_desc"
                android:layoutWidth="match_parent"
                android:layoutHeight="wrap_content"
                android:hint="@string/creator_game_desc_hint"
                android:layout_marginTop="@dimen/spacing_m"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_desc"
                    android:layoutWidth="match_parent"
                    android:layoutHeight="wrap_content"
                    android:lines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layoutWidth="wrap_content"
                android:layoutHeight="wrap_content"
                android:text="Configured Checkpoints"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="@dimen/spacing_l" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_editor_checkpoints"
                android:layoutWidth="match_parent"
                android:layoutHeight="wrap_content"
                android:layout_marginTop="@dimen/spacing_s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_checkpoint"
                android:layoutWidth="match_parent"
                android:layoutHeight="wrap_content"
                android:text="📍 Add Dynamic Checkpoint"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginTop="@dimen/spacing_m" />

            <LinearLayout
                android:layoutWidth="match_parent"
                android:layoutHeight="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_xl">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_draft"
                    android:layoutWidth="0dp"
                    android:layoutHeight="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/creator_save_draft"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_publish"
                    android:layoutWidth="0dp"
                    android:layoutHeight="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/creator_publish_quest"
                    android:backgroundTint="@color/primary_emerald"
                    android:layout_marginStart="@dimen/spacing_xs" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
