<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/elevation_standard"
    app:cardBackgroundColor="@color/bg_dark_card"
    app:strokeColor="@color/border_cyber"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <!-- Top Header: Order Badge, Title, and Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Numbered Sequence Badge -->
            <TextView
                android:id="@+id/tv_sequence_order_badge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="#1"
                android:textColor="@color/on_primary_emerald"
                android:background="@drawable/bg_badge_emerald"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Checkpoint Name -->
            <TextView
                android:id="@+id/tv_row_cp_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Laser Optics Lab"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s" />

            <!-- Sequence Steppers: Move Up / Down / Delete -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_move_up"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="▲"
                    android:textSize="12sp"
                    android:textColor="@color/primary_cyan"
                    android:padding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_move_down"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="▼"
                    android:textSize="12sp"
                    android:textColor="@color/primary_cyan"
                    android:padding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_row"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🗑️"
                    android:textSize="12sp"
                    android:textColor="@color/hud_danger"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Clue Snippet -->
        <TextView
            android:id="@+id/tv_row_clue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Where coherent photons align in darkness."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

        <!-- Sensor Constraints Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_chip_radius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 20m"
                android:textColor="@color/primary_cyan"
                android:background="@drawable/bg_badge_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/tv_chip_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 400-900lx"
                android:textColor="@color/on_secondary_amber"
                android:background="@drawable/bg_badge_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/tv_chip_motion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📳 SWEEP"
                android:textColor="@color/on_primary_emerald"
                android:background="@drawable/bg_badge_emerald"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
