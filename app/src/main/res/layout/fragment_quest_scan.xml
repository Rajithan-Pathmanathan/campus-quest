<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_base">

    <!-- CameraX Preview / AR Container -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Cyberpunk HUD Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hud_top_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/elevation_standard"
        app:cardBackgroundColor="@color/hud_background_transparent"
        app:strokeColor="@color/border_cyber"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_hud_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Historic Clock Tower"
                    android:textColor="@color/primary_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hud_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCANNING SIGNALS"
                    android:textColor="@color/on_secondary_amber"
                    android:background="@drawable/bg_badge_gold"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hud_clue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clue: Look skyward where the bell chimes above the quad."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Center Reticle / Scanning Compass Reticle -->
    <ImageView
        android:id="@+id/iv_reticle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_compass_needle"
        android:contentDescription="Scanning Reticle"
        android:background="@drawable/bg_radar_disc"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/hud_top_card"
        app:layout_constraintBottom_toTopOf="@id/hud_sensors_grid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4-Sensor Multi-Sensor Matrix Grid -->
    <LinearLayout
        android:id="@+id/hud_sensors_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_s"
        app:layout_constraintBottom_toTopOf="@id/hud_bottom_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 1: GPS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/hud_background_transparent"
                app:strokeColor="@color/border_cyber"
                app:strokeWidth="1dp"
                android:layout_marginEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 GPS FIX (40%)"
                        android:textColor="@color/primary_cyan"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_gps_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/primary_emerald"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Light -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/hud_background_transparent"
                app:strokeColor="@color/border_cyber"
                app:strokeWidth="1dp"
                android:layout_marginStart="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 LIGHT (30%)"
                        android:textColor="@color/secondary_amber"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_light_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="450 lx (Match)"
                        android:textColor="@color/primary_emerald"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <!-- Card 3: Motion -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/hud_background_transparent"
                app:strokeColor="@color/border_cyber"
                app:strokeWidth="1dp"
                android:layout_marginEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📳 MOTION (30%)"
                        android:textColor="@color/primary_emerald_light"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_motion_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SWEEP Detected"
                        android:textColor="@color/primary_emerald"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Proximity Gate -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/hud_background_transparent"
                app:strokeColor="@color/border_cyber"
                app:strokeWidth="1dp"
                android:layout_marginStart="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧲 PROXIMITY GATE"
                        android:textColor="@color/rarity_epic"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_proximity_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEAR Confirmed"
                        android:textColor="@color/primary_emerald"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Composite Fusion Progress Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hud_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/hud_background_transparent"
        app:strokeColor="@color/border_cyber"
        app:strokeWidth="1dp"
        app:cardElevation="@dimen/elevation_standard"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SENSOR FUSION RESONANCE"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_fusion_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/primary_emerald"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_fusion_meter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/primary_emerald"
                android:layout_marginTop="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_claim_discovery"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Claim Relic Discovery"
                android:backgroundTint="@color/primary_emerald"
                android:textColor="@color/on_primary_emerald"
                android:layout_marginTop="@dimen/spacing_s"
                android:enabled="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
