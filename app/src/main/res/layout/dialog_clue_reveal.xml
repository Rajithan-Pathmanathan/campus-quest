<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Memory restored ✨"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary_emerald" />

    <TextView
        android:id="@+id/tv_dialog_cp_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="@dimen/spacing_s" />

    <TextView
        android:id="@+id/tv_dialog_rarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/secondary_amber_dark"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_clue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="italic"
        android:textColor="@color/text_primary"
        android:layout_marginTop="@dimen/spacing_m" />

    <TextView
        android:id="@+id/tv_dialog_lore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/spacing_m" />

</LinearLayout>
