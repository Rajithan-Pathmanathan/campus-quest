<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/elevation_standard"
    app:cardBackgroundColor="@color/bg_dark_card"
    app:strokeColor="@color/border_cyber"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <!-- Top Header: Status Badge and Checkpoint Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_creator_game_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DRAFT IN PROGRESS"
                android:textColor="@color/on_secondary_amber"
                android:background="@drawable/bg_badge_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_creator_checkpoint_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 3 Checkpoints"
                android:textColor="@color/primary_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quest Title -->
        <TextView
            android:id="@+id/tv_creator_game_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantum Physics Mystery Quest"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Quest Description -->
        <TextView
            android:id="@+id/tv_creator_game_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Locate laser optics labs, particle physics simulators, and sensor resonance nodes."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="8dp" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_quest"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Edit / Builder"
                android:textSize="12sp"
                android:backgroundTint="@color/bg_dark_card_elevated"
                android:textColor="@color/primary_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publish_quest"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Publish"
                android:textSize="12sp"
                android:backgroundTint="@color/primary_emerald"
                android:textColor="@color/on_primary_emerald"
                android:layout_marginStart="@dimen/spacing_s" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_quest"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑️"
                android:textSize="14sp"
                android:textColor="@color/hud_danger" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
