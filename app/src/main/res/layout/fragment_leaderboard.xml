<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_base">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/primary_cyan"
            app:title="Quest Leaderboard"
            app:titleTextColor="@color/text_primary"
            app:subtitle="Colombo Heritage Trail"
            app:subtitleTextColor="@color/primary_cyan" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_l">

            <!-- Current Player Standing Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_player_standing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/elevation_standard"
                app:cardBackgroundColor="@color/primary_emerald_container"
                app:strokeColor="@color/primary_emerald"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:id="@+id/tv_player_standing_rank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#4"
                        android:textColor="@color/primary_emerald"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_m">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Standing"
                            android:textColor="@color/primary_emerald_light"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_player_standing_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Player_You"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_player_standing_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="420 pts"
                        android:textColor="@color/primary_emerald"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Top 3 Cyberpunk Podium Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_podium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/elevation_standard"
                app:cardBackgroundColor="@color/bg_dark_card"
                app:strokeColor="@color/border_cyber"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 HALL OF DISCOVERY"
                        android:textColor="@color/secondary_amber"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal" />

                    <!-- 3 Podium Columns: 2nd (Silver), 1st (Gold), 3rd (Bronze) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="@dimen/spacing_m">

                        <!-- 2nd Place (Silver) -->
                        <LinearLayout
                            android:id="@+id/podium_second_place"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/bg_card_cyber"
                            android:padding="@dimen/spacing_s"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥈 2ND"
                                android:textColor="@color/rarity_rare"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_podium_2_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Elena_R"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tv_podium_2_pts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="500 pts"
                                android:textColor="@color/primary_cyan"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_podium_2_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14m 00s"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- 1st Place (Gold Champion) -->
                        <LinearLayout
                            android:id="@+id/podium_first_place"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.15"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/bg_badge_gold"
                            android:padding="@dimen/spacing_m"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👑 1ST CHAMPION"
                                android:textColor="@color/on_secondary_amber"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_podium_1_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CyberSeeker_99"
                                android:textColor="@color/on_secondary_amber"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tv_podium_1_pts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="650 pts"
                                android:textColor="@color/on_secondary_amber"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_podium_1_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12m 20s"
                                android:textColor="@color/on_secondary_amber"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- 3rd Place (Bronze) -->
                        <LinearLayout
                            android:id="@+id/podium_third_place"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/bg_card_cyber"
                            android:padding="@dimen/spacing_s"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥉 3RD"
                                android:textColor="@color/rarity_legendary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_podium_3_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Marcus_V"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tv_podium_3_pts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="500 pts"
                                android:textColor="@color/primary_cyan"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_podium_3_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16m 00s"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Title: All Challengers -->
            <TextView
                android:id="@+id/tv_challengers_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHALLENGERS RANKING"
                android:textColor="@color/primary_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <!-- Ranked List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_leaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_leaderboard_entry" />

            <!-- Empty State Container -->
            <LinearLayout
                android:id="@+id/layout_empty_leaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📜"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Explorers Yet"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_m" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Be the first to complete this quest and claim the #1 Champion crown!"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
