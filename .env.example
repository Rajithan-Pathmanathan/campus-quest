# Campus Quest: local settings
# Copy the keys you need into local.properties (git-ignored). Blank or missing = feature off.
# Full guide: documentation/PRODUCTION_SETUP.md

# --- Firebase ---
# Not a key here: put the project's google-services.json in app/ (Firebase Console ->
# Project settings -> Your apps -> com.campusquest -> Download google-services.json).

# --- New-quest push notifications (server/notify-new-quest on Vercel) ---
# NEW_QUEST_NOTIFY_URL=https://<your-project>.vercel.app/api/notify-new-quest

# --- Privacy policy shown from the dashboard (required for Google Play) ---
# PRIVACY_POLICY_URL=https://<where-you-host-it>/privacy

# --- Release version (bump for every Play upload) ---
# VERSION_CODE=1
# VERSION_NAME=1.0.0

# --- Release signing: keystore.properties at the project root (git-ignored), NOT here ---
# storeFile=release.jks
# storePassword=...
# keyAlias=campusquest
# keyPassword=...

# Map: OpenStreetMap (osmdroid) - no API key needed.
