# Campus Quest Environment Configuration Example
# Copy this file to .env or local.properties and replace with your actual keys

# Google Maps Android SDK API Key
# Obtain from: https://console.cloud.google.com/google/maps-apis/credentials
MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHereForCampusQuest

# Firebase Configuration
# Download your actual google-services.json from Firebase Console:
# Project Settings > General > Your apps > Download google-services.json
# Place google-services.json in the 'app/' directory
FIREBASE_PROJECT_ID=campus-quest-dev
FIREBASE_APPLICATION_ID=com.campusquest
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere

# Application Environment (DEBUG / RELEASE)
APP_ENVIRONMENT=DEBUG

# Campus Quest Geofence Defaults (in meters)
DEFAULT_GEOFENCE_RADIUS_METERS=25.0
MAX_GEOFENCE_RADIUS_METERS=100.0
MIN_GEOFENCE_RADIUS_METERS=10.0

# Sensor Fusion Engine Thresholds
DEFAULT_ACCEL_SHAKE_THRESHOLD=14.5
DEFAULT_PROXIMITY_THRESHOLD_CM=1.0
DEFAULT_FUSION_SAMPLING_RATE_MS=100
